(module
  (memory (export "memory") 1 4)
  (table $ft 2 funcref)
  (table $et 2 externref)
  (tag $e (param i32))
  (func (export "grow") (param i32) (result i32) (memory.grow (local.get 0)))
  (func (export "tgrow") (result i32) (table.grow $et (ref.null extern) (i32.const 1)))
  (func (export "tgrowf") (result i32) (table.grow $ft (ref.null func) (i32.const 1)))
  (func $thrower (export "thrower") (param i32) (throw $e (local.get 0)))
  (func (export "catcher") (param i32) (result i32)
    (block $out (result i32)
      (try_table (catch $e $out)
        (call $thrower (local.get 0))
        (i32.const -1)
        (br 1))
      (i32.const -2)))
  (func (export "oob") (result i32) (i32.load (i32.const 0x7ffffff0))))
