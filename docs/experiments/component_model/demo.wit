// wit/demo.wit
package demo:text@0.1.0;

interface host {
  lookup: func(key: string) -> u32;
  log: func(msg: string);
}

interface api {
  greet: func(name: string) -> string;
}

interface inspect {
  last-log: func() -> string;
  calls: func() -> u32;
}

/// the extension: needs a host
world guest {
  import host;
  export api;
}

/// the host functions, written as a wasm module with wit-bindgen
world provider {
  export host;
  export inspect;
}
