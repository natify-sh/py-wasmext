;; A core module of the shape `wasm-tools component unbundle` leaves, by hand, for the files of WASI 0.2: each export calls one import with its arguments, so that
;; a test can lay out the memory (the canonical ABI) and read what the host wrote.
(module
  (import "wasi:filesystem/preopens@0.2.12" "get-directories" (func $dirs (param i32)))
  (import "wasi:filesystem/types@0.2.12" "[method]descriptor.open-at" (func $open (param i32 i32 i32 i32 i32 i32 i32)))
  (import "wasi:filesystem/types@0.2.12" "[method]descriptor.read-via-stream" (func $readvia (param i32 i64 i32)))
  (import "wasi:filesystem/types@0.2.12" "[method]descriptor.write-via-stream" (func $writevia (param i32 i64 i32)))
  (import "wasi:filesystem/types@0.2.12" "[method]descriptor.create-directory-at" (func $mkdir (param i32 i32 i32 i32)))
  (import "wasi:filesystem/types@0.2.12" "[method]descriptor.unlink-file-at" (func $unlink (param i32 i32 i32 i32)))
  (import "wasi:filesystem/types@0.2.12" "[resource-drop]descriptor" (func $dropd (param i32)))
  (import "wasi:io/streams@0.2.12" "[method]input-stream.blocking-read" (func $read (param i32 i64 i32)))
  (import "wasi:io/streams@0.2.12" "[method]output-stream.blocking-write-and-flush" (func $write (param i32 i32 i32 i32)))
  (import "wasi:io/streams@0.2.12" "[resource-drop]input-stream" (func $dropi (param i32)))
  (import "wasi:io/streams@0.2.12" "[resource-drop]output-stream" (func $dropo (param i32)))
  (memory (export "memory") 2)
  (global $heap (mut i32) (i32.const 16384))
  (func (export "cabi_realloc") (param $old i32) (param $old_size i32) (param $align i32) (param $size i32) (result i32)
    (local $p i32)
    (local.set $p
      (i32.and
        (i32.add (global.get $heap) (i32.sub (local.get $align) (i32.const 1)))
        (i32.xor (i32.sub (local.get $align) (i32.const 1)) (i32.const -1))))
    (global.set $heap (i32.add (local.get $p) (local.get $size)))
    (local.get $p))
  (func (export "dirs") (param i32) (call $dirs (local.get 0)))
  (func (export "open") (param i32 i32 i32 i32 i32 i32 i32)
    (call $open (local.get 0) (local.get 1) (local.get 2) (local.get 3) (local.get 4) (local.get 5) (local.get 6)))
  (func (export "read_via") (param i32 i64 i32) (call $readvia (local.get 0) (local.get 1) (local.get 2)))
  (func (export "write_via") (param i32 i64 i32) (call $writevia (local.get 0) (local.get 1) (local.get 2)))
  (func (export "mkdir") (param i32 i32 i32 i32) (call $mkdir (local.get 0) (local.get 1) (local.get 2) (local.get 3)))
  (func (export "unlink") (param i32 i32 i32 i32) (call $unlink (local.get 0) (local.get 1) (local.get 2) (local.get 3)))
  (func (export "drop_descriptor") (param i32) (call $dropd (local.get 0)))
  (func (export "read") (param i32 i64 i32) (call $read (local.get 0) (local.get 1) (local.get 2)))
  (func (export "write") (param i32 i32 i32 i32) (call $write (local.get 0) (local.get 1) (local.get 2) (local.get 3)))
  (func (export "drop_input") (param i32) (call $dropi (local.get 0)))
  (func (export "drop_output") (param i32) (call $dropo (local.get 0))))
